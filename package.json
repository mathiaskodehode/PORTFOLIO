{
    "name": "portfolio",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "run-p type-check \"build-only {@}\" --",
        "build-only": "vite build",
        "postbuild": "node -e \"require('fs').copyFileSync('dist/index.html','dist/404.html')\"",
        "preview": "vite preview",
        "type-check": "vue-tsc --build",
        "test": "vitest run --config=vitest.browser.config.ts",
        "prepare": "husky",
        "lint": "oxlint"
    },
    "dependencies": {
        "vue": "^3.5.40",
        "vue-router": "^5.3.1"
    },
    "devDependencies": {
        "@tsconfig/node24": "^24.0.4",
        "@types/markdown-it": "^14.1.2",
        "@types/node": "^24.13.3",
        "@vitejs/plugin-vue": "^6.0.8",
        "@vitest/browser-playwright": "^5.0.0",
        "@vue/test-utils": "^2.5.0",
        "@vue/tsconfig": "^0.9.1",
        "gray-matter": "^4.0.3",
        "happy-dom": "^20.14.0",
        "husky": "^9.1.7",
        "lint-staged": "^17.5.0",
        "markdown-it": "^14.1.0",
        "npm-run-all2": "^9.0.2",
        "oxfmt": "^0.67.0",
        "oxlint": "^1.82.0",
        "typescript": "~6.0.0",
        "vite": "^8.1.5",
        "vite-plugin-vue-devtools": "^8.1.5",
        "vitest": "^5.0.0",
        "vitest-browser-vue": "^3.1.0",
        "vue-tsc": "^3.3.7"
    },
    "engines": {
        "node": "^22.18.0 || >=24.12.0"
    }
}
